---
import CaleLatestPosts from './CaleLatestPosts.astro';

type Locale = 'ko' | 'en' | 'ja';

const { locale = 'ko' } = Astro.props as { locale?: Locale };

const withLocale = (path: string) => {
  if (locale === 'ko') return path;
  return `/${locale}${path}`;
};

const copy = {
  ko: {
    eyebrow: 'Documentation hub',
    title: 'Cale 문서를 처음 읽는 경로',
    body:
      'Cale은 언어, 컴파일러 파이프라인, 독립 디버거, 릴리즈 계획이 함께 자라는 프로젝트입니다. 이 페이지는 sidebar를 뒤지기 전에 전체 구조를 빠르게 잡기 위한 문서 허브입니다.',
    cards: [
      {
        title: 'Get Started',
        href: withLocale('/getting-started/'),
        text: '현재 프로젝트 상태, 빌드 전제, 첫 실행 흐름을 확인합니다.',
      },
      {
        title: 'Language',
        href: withLocale('/language/'),
        text: 'C lane과 Cale lane이 어떻게 공존하는지, C ABI를 어떤 경계로 보는지 정리합니다.',
      },
      {
        title: 'Compiler Pipeline',
        href: withLocale('/compiler/'),
        text: 'C source가 SIR, FIR, BCIR, Sol로 낮아지는 흐름을 따라갑니다.',
      },
      {
        title: 'Lacail Debugger',
        href: withLocale('/lacail/'),
        text: 'LLDB처럼 멈추고, Cale artifact가 있으면 의미론까지 설명하는 독립 debugger 방향입니다.',
      },
      {
        title: 'C ABI / Interop',
        href: withLocale('/language/'),
        text: 'C를 버리지 않고 기존 OS, kernel, runtime 경계와 공존하는 전략을 설명합니다.',
      },
      {
        title: 'Releases / Roadmap',
        href: withLocale('/releases/'),
        text: 'GitHub Releases 기반 binary 배포와 source build 중심의 현재 경로를 확인합니다.',
      },
    ],
    topics: [
      ['C lane', 'C source와 ABI를 받아들이는 호환 경로'],
      ['SIR/FIR/BCIR/Sol', 'source 의미를 보존하며 낮은 단계로 내려가는 IR 파이프라인'],
      ['UB facts', '위험한 실행 의미를 compiler/debugger가 읽을 수 있게 만든 증거'],
      ['Semantic trace', 'source span, IR value, 낮은 수준 위치를 잇는 의미론 추적'],
      ['Debug artifact contract', 'Lacail이 Cale 내부 구조가 아니라 파일 계약을 소비하는 경계'],
    ],
    aiTitle: 'AI-friendly index',
    aiBody:
      'AI assistant와 검색 crawler가 Cale의 문서 구조를 빠르게 파악할 수 있도록 llms.txt와 Markdown-friendly index를 제공합니다.',
    aiLinks: [
      ['llms.txt', '/llms.txt', '짧은 프로젝트 요약과 주요 문서 링크'],
      ['docs-index.md', '/docs-index.md', 'Markdown으로 읽기 쉬운 Cale 문서 색인'],
      ['robots.txt', '/robots.txt', 'crawler 접근 정책과 sitemap 위치'],
      ['sitemap-index.xml', '/sitemap-index.xml', 'Google Search Console에 제출할 sitemap index'],
    ],
  },
  en: {
    eyebrow: 'Documentation hub',
    title: 'The first path through Cale docs',
    body:
      'Cale spans language design, a compiler pipeline, a standalone debugger, and a release path. This hub gives readers a project map before they dive into the sidebar.',
    cards: [
      {
        title: 'Get Started',
        href: withLocale('/getting-started/'),
        text: 'Understand the current project state, build assumptions, and first steps.',
      },
      {
        title: 'Language',
        href: withLocale('/language/'),
        text: 'See how the C lane and Cale lane coexist around the C ABI.',
      },
      {
        title: 'Compiler Pipeline',
        href: withLocale('/compiler/'),
        text: 'Follow C source through SIR, FIR, BCIR, and Sol.',
      },
      {
        title: 'Lacail Debugger',
        href: withLocale('/lacail/'),
        text: 'A standalone debugger direction: stop like LLDB, explain more with Cale artifacts.',
      },
      {
        title: 'C ABI / Interop',
        href: withLocale('/language/'),
        text: 'How Cale stays compatible with OS, kernel, runtime, and existing C boundaries.',
      },
      {
        title: 'Releases / Roadmap',
        href: withLocale('/releases/'),
        text: 'Source builds today, GitHub Releases based binaries later.',
      },
    ],
    topics: [
      ['C lane', 'Compatibility path for C source and ABI boundaries'],
      ['SIR/FIR/BCIR/Sol', 'The lowering pipeline that keeps source meaning recoverable'],
      ['UB facts', 'Evidence records for dangerous execution meaning'],
      ['Semantic trace', 'Links between source spans, IR values, and lower-level locations'],
      ['Debug artifact contract', 'File-oriented boundary consumed by Lacail'],
    ],
    aiTitle: 'AI-friendly index',
    aiBody:
      'Cale provides llms.txt and a Markdown-friendly docs index so AI assistants and crawlers can understand the public documentation structure.',
    aiLinks: [
      ['llms.txt', '/llms.txt', 'Short project summary and key links'],
      ['docs-index.md', '/docs-index.md', 'Markdown-friendly documentation index'],
      ['robots.txt', '/robots.txt', 'Crawler policy and sitemap hints'],
      ['sitemap-index.xml', '/sitemap-index.xml', 'Sitemap index for Google Search Console'],
    ],
  },
  ja: {
    eyebrow: 'Documentation hub',
    title: 'Japanese documentation is being prepared',
    body:
      'This page keeps the docs hub structure aligned while Japanese content is prepared. The links below point to the same Cale language, compiler, debugger, and release surfaces.',
    cards: [
      {
        title: 'Get Started',
        href: withLocale('/getting-started/'),
        text: 'Project status and first steps placeholder.',
      },
      {
        title: 'Language',
        href: withLocale('/language/'),
        text: 'C lane and C ABI compatibility placeholder.',
      },
      {
        title: 'Compiler Pipeline',
        href: withLocale('/compiler/'),
        text: 'SIR, FIR, BCIR, and Sol overview placeholder.',
      },
      {
        title: 'Lacail Debugger',
        href: withLocale('/lacail/'),
        text: 'Standalone debugger placeholder.',
      },
      {
        title: 'C ABI / Interop',
        href: withLocale('/language/'),
        text: 'Interop documentation placeholder.',
      },
      {
        title: 'Releases / Roadmap',
        href: withLocale('/releases/'),
        text: 'Release planning placeholder.',
      },
    ],
    topics: [
      ['C lane', 'Compatibility path placeholder'],
      ['SIR/FIR/BCIR/Sol', 'Compiler pipeline placeholder'],
      ['UB facts', 'Analysis evidence placeholder'],
      ['Semantic trace', 'Semantic trace placeholder'],
      ['Debug artifact contract', 'Artifact boundary placeholder'],
    ],
    aiTitle: 'AI-friendly index',
    aiBody:
      'llms.txt and docs-index.md are available for crawlers and AI assistants.',
    aiLinks: [
      ['llms.txt', '/llms.txt', 'Project summary and key links'],
      ['docs-index.md', '/docs-index.md', 'Markdown-friendly documentation index'],
      ['robots.txt', '/robots.txt', 'Crawler policy'],
      ['sitemap-index.xml', '/sitemap-index.xml', 'Sitemap index'],
    ],
  },
} satisfies Record<Locale, {
  eyebrow: string;
  title: string;
  body: string;
  cards: Array<{ title: string; href: string; text: string }>;
  topics: Array<[string, string]>;
  aiTitle: string;
  aiBody: string;
  aiLinks: Array<[string, string, string]>;
}>;

const t = copy[locale];
---

<div class="cale-docs-landing">
  <section class="cale-docs-hero" aria-labelledby={`cale-docs-title-${locale}`}>
    <p class="cale-section-eyebrow">{t.eyebrow}</p>
    <h2 id={`cale-docs-title-${locale}`}>{t.title}</h2>
    <p>{t.body}</p>
  </section>

  <section class="cale-docs-card-grid" aria-label="documentation entry points">
    {t.cards.map((card) => (
      <a class="cale-docs-card" href={card.href}>
        <span>{card.title}</span>
        <p>{card.text}</p>
      </a>
    ))}
  </section>

  <CaleLatestPosts locale={locale} title="Latest posts" compact />

  <section class="cale-docs-topics" aria-label="popular topics">
    <div>
      <p class="cale-section-eyebrow">Popular topics</p>
      <h2>What to read first</h2>
    </div>
    <dl>
      {t.topics.map(([topic, description]) => (
        <div>
          <dt>{topic}</dt>
          <dd>{description}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="cale-docs-ai" aria-labelledby={`cale-docs-ai-${locale}`}>
    <div>
      <p class="cale-section-eyebrow">Index</p>
      <h2 id={`cale-docs-ai-${locale}`}>{t.aiTitle}</h2>
      <p>{t.aiBody}</p>
    </div>
    <div class="cale-docs-ai-links">
      {t.aiLinks.map(([label, href, text]) => (
        <a href={href}>
          <strong>{label}</strong>
          <span>{text}</span>
        </a>
      ))}
    </div>
  </section>
</div>
